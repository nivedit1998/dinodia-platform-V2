  homeId                    String       @db.Uuid
  hubInstallationId         String       @db.Uuid
  purpose                   ClaimPurpose
  generation                Int          @default(1)
  state                     ClaimState   @default(AVAILABLE)
  companyQrReferenceHash    String       @db.VarChar(128)
  transferCodeHash          String?      @db.VarChar(128)
