  outgoingOwnerMembershipId String?      @db.Uuid
  claimedAccountId          String?      @db.Uuid
  issuedAt                  DateTime     @default(now())
  reservedAt                DateTime?
  consumedAt                DateTime?
  cancelledAt               DateTime?
  replacedAt                DateTime?
  revokedAt                 DateTime?
  invalidatedAt             DateTime?
