  reservationExpiresAt  DateTime?
  releasedAt            DateTime?
  claimedAt             DateTime?
  setupCheckpoint       Json?
  audits                Stage1ClaimAudit[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([hubInstallId, state])
  @@index([reservationExpiresAt])
}

model Stage1ClaimAudit {
  id            String                 @id @default(uuid())
  reservation   Stage1ClaimReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String
  actorUser     User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId   Int?
  action        String
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([reservationId, createdAt])
  @@index([actorUserId, createdAt])
}

model SupportRequestApprovalToken {
  id               String                       @id @default(uuid())
  supportRequest   SupportRequest               @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  supportRequestId String
  recipientType    SupportApprovalRecipientType
  recipientUserId  Int?
  recipientEmail   String
  recipientName    String?
  tokenHash        String                       @unique
  expiresAt        DateTime
  approvedAt       DateTime?
  consumedAt       DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([supportRequestId])
  @@index([expiresAt])
  @@index([recipientUserId])
}
