  areas         MembershipInvitationArea[]

  @@unique([id, homeId])
  @@index([targetEmailNormalized, state, expiresAt])
  @@index([homeId, state, expiresAt])
  @@index([inviterMembershipId, state])
}

model MembershipInvitationArea {
