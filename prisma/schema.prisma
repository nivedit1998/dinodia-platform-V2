generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime clients and guarded migration scripts inject the actual URL.
  // This non-secret local default keeps clean source snapshots reproducible.
  url      = "postgresql://127.0.0.1:5432/dinodia_v2_local"
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum EmployeeRole {
  CXO
  SENIOR_OPERATIONS_MANAGER
  INSTALLER
  SENIOR_CUSTOMER_SUPPORT
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum BootstrapDeliveryStatus {
  PENDING
  SENT
  FAILED
  CONSUMED
  REVOKED
}

enum HomeLifecycle {
  INSTALLING
  CLAIMABLE
  CLAIM_RESERVED
  PENDING_INSTALLATION
  ACTIVE
  TRANSFER_PENDING
  UNOWNED
  DEREGISTRATION_PENDING
  WAITING_FOR_HUB_CLEANUP
  MAINTENANCE
}

enum AddressStatus {
  NOT_PROVIDED
  PENDING_CLAIM
  VERIFIED
  STAFF_CORRECTED
}

enum InstallationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETE
  REOPENED
}

enum MembershipRole {
  OWNER
  PROPERTY_MANAGER
  TENANT
}

enum MembershipStatus {
  ACTIVE
  REMOVAL_PENDING
  REMOVED
}

enum AreaStatus {
  ACTIVE
  RETIRED
}

enum DeviceManagementClass {
  PROPERTY_DEVICE
  TENANT_DEVICE
}

enum DeviceAnalyticsCategory {
  NONE
  LIGHT
  BOILER
  RADIATOR
}

enum DeviceOnlineState {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum DeviceLifecycleState {
  DISCOVERED
  INSTALLED
  VIEW_ONLY
  RETIRED
  REMOVAL_PENDING
  REMOVED
}

enum CompanyWorkKind {
  INITIAL_HUB_INSTALLATION
  PHYSICAL_CONFIGURATION_CORRECTION
  HUB_RECOVERY
}

enum CompanyWorkState {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REOPENED
}

enum HubIdentityStatus {
  ACTIVE
  REVOKED
}

enum HubLifecycleState {
  PAIRING
  PROVISIONED
  MAINTENANCE
  DEREGISTRATION_PENDING
  WAITING_FOR_CLEANUP
  ACTIVE
  REVOKED
}

enum HubCredentialState {
  PENDING
  DELIVERED
  ACKNOWLEDGED
  ACTIVE
  GRACE
  REVOKED
}

enum ProvisioningState {
  CREATED
  PRESENTED
  EMPLOYEE_APPROVED
  CHALLENGE_ISSUED
  HUB_PROVED
  REDEEMED
  CHALLENGE_PENDING
  PROOF_RECEIVED
  CREDENTIAL_DELIVERED
  ACKNOWLEDGED
  CONSUMED
  COMPLETED
  EXPIRED
  REVOKED
  FAILED
}

enum InvitationRole {
  PROPERTY_MANAGER
  TENANT
}

enum InvitationState {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
  REPLACED
}

enum AreaQrStatus {
  ACTIVE
  DISABLED
  REPLACED
}

enum AreaAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ClaimPurpose {
  INITIAL_OWNER
  OWNERSHIP_TRANSFER
}

enum ClaimState {
  AVAILABLE
  RESERVED
  PENDING_INSTALLATION
  CONSUMED
  CANCELLED
  REPLACED
  REVOKED
  INVALIDATED
}

enum ClaimReservationState {
  ACTIVE
  CONVERTED_TO_PENDING_INSTALLATION
  EXPIRED
  MANUALLY_RELEASED
  CANCELLED
}

enum PendingHomeSetupState {
  PROFILE_REQUIRED
  ADDRESS_REQUIRED
  POLICY_REQUIRED
  PENDING_INSTALLATION
  READY_TO_ACTIVATE
  EXPIRED
  CANCELLED
  ACTIVATED
}

enum HomeDocumentKind {
  FLOORPLAN
  AREA_PRESENTATION
}

enum MemberPreferenceKind {
  DASHBOARD_LAYOUT
  FILTER_STATE
  QUIET_HOURS
}

enum AuditActorType {
  CUSTOMER
  EMPLOYEE
  HUB
  SYSTEM
}

enum AuditCategory {
  MANAGEMENT
  SECURITY
  INSTALLATION
  ACCESS
}

model CustomerAccount {
  id                     String         @id @default(uuid()) @db.Uuid
  displayName            String         @db.VarChar(160)
  username               String         @db.VarChar(80)
  usernameNormalized     String         @unique @db.VarChar(80)
  email                  String         @db.VarChar(320)
  emailNormalized        String         @unique @db.VarChar(320)
  emailVerifiedAt        DateTime?
  pendingEmail           String?        @db.VarChar(320)
  pendingEmailNormalized String?        @db.VarChar(320)
  phoneNumber            String?        @db.VarChar(40)
  passwordHash           String         @db.VarChar(255)
  mustChangePassword     Boolean        @default(false)
  passwordChangedAt      DateTime?
  status                 CustomerStatus @default(ACTIVE)
  securityVersion        Int            @default(1)
  lastUsedHomeId         String?        @db.Uuid
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  lastUsedHome         Home?                       @relation("CustomerLastUsedHome", fields: [lastUsedHomeId], references: [id], onDelete: SetNull)
  memberships          HomeMembership[]
  trustedDevices       TrustedDevice[]
  sessions             CustomerSession[]
  policyAcceptances    PolicyAcceptance[]
  authChallenges       AuthChallenge[]
  stepUpAuthorizations StepUpAuthorization[]
  invitationsReceived  MembershipInvitation[]      @relation("InvitationTarget")
  areaAccessRequests   AreaAccessRequest[]
  claimReservations    HomeClaimReservation[]
  pendingHomeSetups    PendingHomeSetup[]
  createdHomeDocuments HomeDocument[]              @relation("HomeDocumentCreator")
  homeClaimReferences  HomeClaimReference[]
  supportNotifications SupportAccessNotification[]

  @@index([status])
  @@index([lastUsedHomeId])
}

model CompanyEmployeeAccount {
  id                           String         @id @default(uuid()) @db.Uuid
  displayName                  String         @db.VarChar(160)
  email                        String         @db.VarChar(320)
  emailNormalized              String         @unique @db.VarChar(320)
  emailVerifiedAt              DateTime?
  username                     String?        @unique @db.VarChar(80)
  passwordHash                 String?        @db.VarChar(255)
  role                         EmployeeRole
  status                       EmployeeStatus @default(ACTIVE)
  bootstrapInvitationHash      String?        @unique @db.VarChar(128)
  bootstrapInvitationExpiresAt DateTime?
  securityVersion              Int            @default(1)
  recentAuthenticationAt       DateTime?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  assignedWork         CompanyOperationalWorkItem[] @relation("AssignedWork")
  createdWork          CompanyOperationalWorkItem[] @relation("CreatedWork")
  redeemedAttempts     HubProvisioningAttempt[]     @relation("ProvisioningRedeemer")
  releasedReservations HomeClaimReservation[]       @relation("ReservationReleaser")
}

model TrustedDevice {
  id                   String    @id @default(uuid()) @db.Uuid
  customerAccountId    String    @db.Uuid
  deviceInstallationId String    @db.VarChar(160)
  publicKey            String    @db.Text
  publicKeyThumbprint  String    @db.VarChar(128)
  deviceName           String    @db.VarChar(160)
  model                String?   @db.VarChar(160)
  osFamily             String?   @db.VarChar(80)
  osVersion            String?   @db.VarChar(80)
  firstSeenAt          DateTime  @default(now())
  lastUsedAt           DateTime  @default(now())
  revokedAt            DateTime?
  sessionVersion       Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customerAccount CustomerAccount       @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  sessions        CustomerSession[]
  stepUps         StepUpAuthorization[]
  claimChallenges HomeClaimChallenge[]

  @@unique([customerAccountId, deviceInstallationId])
  @@index([customerAccountId, revokedAt])
  @@index([publicKeyThumbprint])
}

model CustomerSession {
  id                          String    @id @default(uuid()) @db.Uuid
  customerAccountId           String    @db.Uuid
  trustedDeviceId             String    @db.Uuid
  refreshTokenHash            String    @unique @db.VarChar(128)
  securityVersion             Int
  trustedDeviceSessionVersion Int       @default(1)
  issuedAt                    DateTime  @default(now())
  expiresAt                   DateTime
  lastUsedAt                  DateTime  @default(now())
  revokedAt                   DateTime?
  revokeReason                String?   @db.VarChar(160)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  trustedDevice   TrustedDevice   @relation(fields: [trustedDeviceId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, revokedAt, expiresAt])
  @@index([trustedDeviceId, revokedAt])
}

model PolicyAcceptance {
  id                String   @id @default(uuid()) @db.Uuid
  customerAccountId String   @db.Uuid
  policyKind        String   @db.VarChar(80)
  policyVersion     String   @db.VarChar(80)
  acceptedAt        DateTime @default(now())
  deviceHash        String?  @db.VarChar(128)
  redactedIpHash    String?  @db.VarChar(128)
  createdAt         DateTime @default(now())

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, policyKind, policyVersion])
}

model AuthChallenge {
  id                String    @id @default(uuid()) @db.Uuid
  customerAccountId String?   @db.Uuid
  purpose           String    @db.VarChar(80)
  targetEmail       String?   @db.VarChar(320)
  tokenHash         String    @unique @db.VarChar(128)
  expiresAt         DateTime
  approvedAt        DateTime?
  consumedAt        DateTime?
  revokedAt         DateTime?
  attemptCount      Int       @default(0)
  supersededById    String?   @db.Uuid
  createdAt         DateTime  @default(now())

  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, purpose, expiresAt])
}

model StepUpAuthorization {
  id                    String    @id @default(uuid()) @db.Uuid
  customerAccountId     String    @db.Uuid
  customerSessionId     String?   @db.Uuid
  trustedDeviceId       String?   @db.Uuid
  homeId                String?   @db.Uuid
  membershipId          String?   @db.Uuid
  operationKind         String    @db.VarChar(120)
  targetDigest          String    @db.VarChar(128)
  normalizedValueDigest String    @db.VarChar(128)
  policyRevision        Int
  nonceHash             String    @db.VarChar(128)
  issuedAt              DateTime  @default(now())
  expiresAt             DateTime
  consumedAt            DateTime?
  revokedAt             DateTime?

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  trustedDevice   TrustedDevice?  @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)

  @@unique([customerAccountId, nonceHash])
  @@index([customerAccountId, expiresAt, consumedAt])
  @@index([homeId, membershipId])
}

model Home {
  id                      String             @id @default(uuid()) @db.Uuid
  addressLine1            String?            @db.VarChar(200)
  addressLine2            String?            @db.VarChar(200)
  city                    String?            @db.VarChar(120)
  region                  String?            @db.VarChar(120)
  postcode                String?            @db.VarChar(32)
  country                 String?            @db.VarChar(2)
  timezone                String?            @db.VarChar(80)
  addressStatus           AddressStatus      @default(NOT_PROVIDED)
  lifecycle               HomeLifecycle      @default(INSTALLING)
  installationStatus      InstallationStatus @default(DRAFT)
  installationCompletedAt DateTime?
  authorityGeneration     Int                @default(1)
  customerDataGeneration  Int                @default(1)
  managementRevision      Int                @default(1)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  lastUsedBy              CustomerAccount[]            @relation("CustomerLastUsedHome")
  memberships             HomeMembership[]
  areas                   Area[]
  devices                 NativeDevice[]
  hubInstallation         HubInstallation?
  workItems               CompanyOperationalWorkItem[]
  operatorBrowserAttempts OperatorBrowserAttempt[]
  invitations             MembershipInvitation[]
  claims                  HomeClaimReference[]
  homeDocuments           HomeDocument[]
  auditEvents             AuditEvent[]
  supportNotifications    SupportAccessNotification[]

  @@index([lifecycle, installationStatus])
  @@index([postcode])
}

model HomeMembership {
  id                String           @id @default(uuid()) @db.Uuid
  customerAccountId String           @db.Uuid
  homeId            String           @db.Uuid
  role              MembershipRole
  status            MembershipStatus @default(ACTIVE)
  accessRevision    Int              @default(1)
  activatedAt       DateTime         @default(now())
  removedAt         DateTime?
  removalReason     String?          @db.VarChar(160)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customerAccount  CustomerAccount            @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  home             Home                       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  tenantAreaGrants TenantAreaGrant[]
  ownedDevices     NativeDevice[]
  preferences      MemberPreferenceDocument[]
  invitationsSent  MembershipInvitation[]     @relation("InvitationInviter")

  @@unique([customerAccountId, homeId])
  @@unique([id, homeId])
  @@index([homeId, role, status])
  @@index([customerAccountId, status])
}

model Area {
  id           String     @id @default(uuid()) @db.Uuid
  homeId       String     @db.Uuid
  osAreaId     String     @db.VarChar(160)
  originalName String     @db.VarChar(160)
  overrideName String?    @db.VarChar(160)
  status       AreaStatus @default(ACTIVE)
  retiredAt    DateTime?
  revision     Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  home                      Home                       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  tenantGrants              TenantAreaGrant[]
  assignments               DeviceAreaAssignment[]
  qrCredentials             AreaQrCredential[]
  accessRequests            AreaAccessRequest[]
  membershipInvitationAreas MembershipInvitationArea[]

  @@unique([homeId, osAreaId])
  @@unique([id, homeId])
  @@index([homeId, status])
}

model TenantAreaGrant {
  id             String    @id @default(uuid()) @db.Uuid
  membershipId   String    @db.Uuid
  areaId         String    @db.Uuid
  homeId         String    @db.Uuid
  policyRevision Int       @default(1)
  grantedAt      DateTime  @default(now())
  revokedAt      DateTime?
  revokeReason   String?   @db.VarChar(160)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  membership HomeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  area       Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([membershipId, areaId])
  @@index([areaId, revokedAt])
}

model NativeDevice {
  id                  String                  @id @default(uuid()) @db.Uuid
  homeId              String                  @db.Uuid
  hubInstallationId   String                  @db.Uuid
  osDeviceId          String                  @db.VarChar(160)
  originalName        String                  @db.VarChar(160)
  overrideName        String?                 @db.VarChar(160)
  technicalLabel      String                  @db.VarChar(80)
  customerLabel       String?                 @db.VarChar(80)
  analyticsCategory   DeviceAnalyticsCategory @default(NONE)
  managementClass     DeviceManagementClass
  ownerMembershipId   String?                 @db.Uuid
  deviceType          String                  @db.VarChar(120)
  manufacturer        String?                 @db.VarChar(160)
  model               String?                 @db.VarChar(160)
  protocol            String?                 @db.VarChar(80)
  capabilitySummary   Json?
  descriptorRevision  Int                     @default(1)
  descriptorDigest    String?                 @db.VarChar(128)
  onlineState         DeviceOnlineState       @default(UNKNOWN)
  lastSeenAt          DateTime?
  radiatorTemperature Decimal?                @db.Decimal(6, 2)
  radiatorReadingAt   DateTime?
  lifecycle           DeviceLifecycleState    @default(DISCOVERED)
  installedAt         DateTime?
  retiredAt           DateTime?
  cleanupDeadlineAt   DateTime?
  inventoryRevision   Int                     @default(1)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  home            Home                   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  hubInstallation HubInstallation        @relation(fields: [hubInstallationId], references: [id], onDelete: Cascade)
  ownerMembership HomeMembership?        @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  assignments     DeviceAreaAssignment[]

  @@unique([hubInstallationId, osDeviceId])
  @@unique([id, homeId])
  @@index([homeId, managementClass, lifecycle])
  @@index([ownerMembershipId, lifecycle])
}

model DeviceAreaAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @db.Uuid
  areaId     String    @db.Uuid
  homeId     String    @db.Uuid
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  source     String    @db.VarChar(80)
  actorType  String?   @db.VarChar(32)
  actorId    String?   @db.Uuid
  createdAt  DateTime  @default(now())

  device NativeDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  area   Area         @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([deviceId, validUntil])
  @@index([areaId, validFrom, validUntil])
  @@index([homeId, deviceId, validUntil])
}

model HubManufacturingIdentity {
  id                       String            @id @default(uuid()) @db.Uuid
  serialNumber             String            @db.VarChar(120)
  signingPublicKey         String            @db.Text
  encryptionPublicKey      String            @db.Text
  signingKeyFingerprint    String            @unique @db.VarChar(128)
  encryptionKeyFingerprint String            @unique @db.VarChar(128)
  identityGeneration       Int               @default(1)
  certificate              String?           @db.Text
  status                   HubIdentityStatus @default(ACTIVE)
  revokedAt                DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  hubInstallation      HubInstallation?
  provisioningAttempts HubProvisioningAttempt[]

  @@unique([serialNumber, identityGeneration])
}

model CompanyOperationalWorkItem {
  id                    String           @id @default(uuid()) @db.Uuid
  publicReference       String           @unique @db.VarChar(32)
  kind                  CompanyWorkKind
  state                 CompanyWorkState @default(ASSIGNED)
  homeId                String?          @db.Uuid
  hubInstallationId     String?          @db.Uuid
  certifiedSerialNumber String?          @db.VarChar(120)
  assignedEmployeeId    String           @db.Uuid
  createdByEmployeeId   String           @db.Uuid
  reason                String           @db.VarChar(500)
  notes                 String?          @db.VarChar(2000)
  workRevision          Int              @default(1)
  checklistRevision     Int?
  startedAt             DateTime?
  completedAt           DateTime?
  reopenedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  home                 Home?                    @relation(fields: [homeId], references: [id], onDelete: SetNull)
  hubInstallation      HubInstallation?         @relation(fields: [hubInstallationId], references: [id], onDelete: SetNull)
  assignedEmployee     CompanyEmployeeAccount   @relation("AssignedWork", fields: [assignedEmployeeId], references: [id], onDelete: Restrict)
  createdBy            CompanyEmployeeAccount   @relation("CreatedWork", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  provisioningAttempts HubProvisioningAttempt[]

  @@unique([id, homeId])
  @@index([assignedEmployeeId, state])
  @@index([homeId, state])
  @@index([hubInstallationId, state])
}

model HubInstallation {
  id                               String            @id @default(uuid()) @db.Uuid
  homeId                           String            @unique @db.Uuid
  manufacturingIdentityId          String            @unique @db.Uuid
  serialNumberSnapshot             String            @unique @db.VarChar(120)
  state                            HubLifecycleState @default(PAIRING)
  provisioningRevision             Int               @default(1)
  baseUrl                          String?           @db.VarChar(500)
  cloudUrl                         String?           @db.VarChar(500)
  cloudUrlVerifiedAt               DateTime?
  cloudflareTunnelId               String?           @db.VarChar(200)
  cloudflareTunnelName             String?           @db.VarChar(200)
  cloudflareReservationToken       String?           @db.VarChar(128)
  reservedHostname                 String?           @db.VarChar(255)
  reservedTunnelName               String?           @db.VarChar(200)
  remoteChallengeAt                DateTime?
  remoteVerificationAt             DateTime?
  currentCredentialVersion         Int?
  // Deprecated compatibility field. Runtime authority uses the purpose-specific pointers.
  currentMachineCredentialVersion  Int?
  currentOperatorCredentialVersion Int?
  accessPolicyRevision             Int               @default(1)
  lastSeenAt                       DateTime?
  onlineStateEvaluatedAt           DateTime?
  runtimeVersion                   String?           @db.VarChar(120)
  capabilitySummary                Json?
  cleanupState                     String?           @db.VarChar(80)
  cleanupGeneration                Int               @default(0)
  permanentResolverHash            String?           @unique @db.VarChar(128)
  permanentResolverGeneration      Int               @default(1)
  permanentResolverStatus          String            @default("ACTIVE") @db.VarChar(32)
  resolverIssuedAt                 DateTime?
  resolverReplacedAt               DateTime?
  resolverRevokedAt                DateTime?
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt

  home                    Home                         @relation(fields: [homeId], references: [id], onDelete: Restrict)
  manufacturingIdentity   HubManufacturingIdentity     @relation(fields: [manufacturingIdentityId], references: [id], onDelete: Restrict)
  devices                 NativeDevice[]
  credentialVersions      HubCredentialVersion[]
  provisioningAttempts    HubProvisioningAttempt[]
  operatorBrowserAttempts OperatorBrowserAttempt[]
  workItems               CompanyOperationalWorkItem[]
  idempotencyRecords      IdempotencyRecord[]
  homeClaimReferences     HomeClaimReference[]
  homeClaimChallenges     HomeClaimChallenge[]

  @@unique([id, homeId])
  @@unique([id, manufacturingIdentityId])
  @@index([state, lastSeenAt])
}

model HubCredentialVersion {
  id                        String             @id @default(uuid()) @db.Uuid
  hubInstallationId         String             @db.Uuid
  version                   Int
  purpose                   String             @default("operator-credential") @db.VarChar(40)
  state                     HubCredentialState @default(PENDING)
  tokenHash                 String             @db.VarChar(128)
  encryptedDeliveryEnvelope Json?
  ciphertextKeyVersion      Int?
  issuedAt                  DateTime           @default(now())
  deliveredAt               DateTime?
  acknowledgedAt            DateTime?
  activatedAt               DateTime?
  graceUntil                DateTime?
  revokedAt                 DateTime?
  revokedReason             String?            @db.VarChar(160)
  deliveryAttempts          Int                @default(0)
  lastDeliveryError         String?            @db.VarChar(500)
  createdAt                 DateTime           @default(now())

  hubInstallation HubInstallation @relation(fields: [hubInstallationId], references: [id], onDelete: Cascade)

  @@unique([hubInstallationId, purpose, version], name: "HubCredentialVersion_hub_purpose_version_key")
  @@index([hubInstallationId, purpose, state])
}

model HubProvisioningAttempt {
  id                          String            @id @default(uuid()) @db.Uuid
  attemptId                   String            @unique @db.VarChar(160)
  manufacturingIdentityId     String            @db.Uuid
  hubInstallationId           String?           @db.Uuid
  companyWorkItemId           String?           @db.Uuid
  redeemerEmployeeId          String?           @db.Uuid
  state                       ProvisioningState @default(CREATED)
  codeHash                    String            @db.VarChar(128)
  baseUrlPresentation         String            @db.VarChar(500)
  challengeHash               String?           @db.VarChar(128)
  challengeExpiresAt          DateTime?
  hubProofAt                  DateTime?
  encryptedCredentialEnvelope Json?
  deliveredAt                 DateTime?
  acknowledgedAt              DateTime?
  expiresAt                   DateTime
  failureCount                Int               @default(0)
  idempotencyKeyHash          String            @db.VarChar(128)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  manufacturingIdentity HubManufacturingIdentity    @relation(fields: [manufacturingIdentityId], references: [id], onDelete: Restrict)
  hubInstallation       HubInstallation?            @relation(fields: [hubInstallationId], references: [id], onDelete: SetNull)
  companyWorkItem       CompanyOperationalWorkItem? @relation(fields: [companyWorkItemId], references: [id], onDelete: Restrict)
  redeemerEmployee      CompanyEmployeeAccount?     @relation("ProvisioningRedeemer", fields: [redeemerEmployeeId], references: [id], onDelete: SetNull)

  @@unique([manufacturingIdentityId, idempotencyKeyHash])
  @@index([manufacturingIdentityId, state, expiresAt])
  @@index([companyWorkItemId, state])
}

model MembershipInvitation {
  id                      String          @id @default(uuid()) @db.Uuid
  homeId                  String          @db.Uuid
  inviterMembershipId     String          @db.Uuid
  targetAccountId         String?         @db.Uuid
  targetEmail             String          @db.VarChar(320)
  targetEmailNormalized   String          @db.VarChar(320)
  role                    InvitationRole
  state                   InvitationState @default(PENDING)
  tokenHash               String          @unique @db.VarChar(128)
  temporaryCredentialHash String?         @db.VarChar(128)
  expiresAt               DateTime
  acceptedAt              DateTime?
  declinedAt              DateTime?
  revokedAt               DateTime?
  replacementOfId         String?         @db.Uuid
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  home          Home                       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  inviter       HomeMembership             @relation("InvitationInviter", fields: [inviterMembershipId], references: [id], onDelete: Restrict)
