// Stage 1 security authorities. These records are deliberately separate from
// customer feature DTOs and are retained by later stages.
enum EmployeeSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

enum SupportAccessScope {
  TENANT_SCOPE
  PROPERTY_SCOPE
}

enum SupportAccessRequestStatus {
  REQUESTED
  APPROVED
  DENIED
  ISSUED
  REDEEMED
  EXPIRED
  REVOKED
  ENDED
}

enum SupportSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  ENDED
  PENDING_HUB_REVOKE
}

enum CloudUrlVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model EmployeeSession {
  id                    String                @id @default(uuid()) @db.Uuid
  employeeId            String                @db.Uuid
  tokenHash             String                @unique @db.VarChar(128)
  status                EmployeeSessionStatus @default(ACTIVE)
  recentAuthenticatedAt DateTime
  expiresAt             DateTime
  revokedAt             DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([employeeId, status, expiresAt])
}

model OperatorHandoff {
  id                       String    @id @default(uuid()) @db.Uuid
  employeeId               String    @db.Uuid
  workflowId               String    @db.Uuid
  homeId                   String    @db.Uuid
  hubInstallationId        String    @db.Uuid
  attemptId                String?   @db.Uuid
  operatorBrowserAttemptId String?   @unique @db.Uuid
  setupAttemptId           String    @db.VarChar(160)
  browserBindingHash       String    @db.VarChar(128)
  handoffHash              String    @unique @db.VarChar(128)
  handoffEnvelope          String    @db.Text
  scope                    Json
  issuedAt                 DateTime  @default(now())
  expiresAt                DateTime
  consumedAt               DateTime?
  revokedAt                DateTime?
  createdAt                DateTime  @default(now())

  operatorBrowserAttempt OperatorBrowserAttempt? @relation(fields: [operatorBrowserAttemptId], references: [id], onDelete: Restrict)

  @@index([employeeId, expiresAt, consumedAt])
  @@index([hubInstallationId, expiresAt, consumedAt])
  @@index([setupAttemptId])
}

// Created by the paired hub before Company Portal creates an operator
// handoff. The browser binding is stored as a hash and cannot be replaced.
model OperatorBrowserAttempt {
  id                 String    @id @default(uuid()) @db.Uuid
  attemptId          String    @unique @db.VarChar(160)
  homeId             String    @db.Uuid
  hubInstallationId  String    @db.Uuid
  browserBindingHash String    @db.VarChar(128)
  issuedAt           DateTime  @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  home            Home              @relation(fields: [homeId], references: [id], onDelete: Restrict)
  hubInstallation HubInstallation   @relation(fields: [hubInstallationId], references: [id], onDelete: Restrict)
  handoffs        OperatorHandoff[]

  @@unique([id, homeId])
  @@index([hubInstallationId, expiresAt, consumedAt, revokedAt])
}

// A server-issued, one-use trusted-phone challenge. The phone signs this
// exact server-created digest after local Face ID/passcode succeeds; clients
// cannot choose the operation authority by posting a nonce directly.
model StepUpChallenge {
  id                     String    @id @default(uuid()) @db.Uuid
  customerAccountId      String    @db.Uuid
  customerSessionId      String    @db.Uuid
  trustedDeviceId        String    @db.Uuid
  homeId                 String    @db.Uuid
  membershipId           String    @db.Uuid
  hubInstallationId      String    @db.Uuid
  operationKind          String    @db.VarChar(120)
  targetDigest           String    @db.VarChar(128)
  normalizedValueDigest  String    @db.VarChar(128)
  policyRevision         Int
  nonceHash              String    @unique @db.VarChar(128)
  hubDescriptorNonceHash String?   @unique @db.VarChar(128)
  issuedAt               DateTime  @default(now())
  expiresAt              DateTime
  consumedAt             DateTime?
  cancelledAt            DateTime?

  @@index([customerSessionId, expiresAt, consumedAt])
  @@index([customerAccountId, homeId, membershipId])
}

model SupportTicket {
  id                   String                      @id @default(uuid()) @db.Uuid
  publicReference      String                      @unique @db.VarChar(32)
  customerAccountId    String                      @db.Uuid
  homeId               String                      @db.Uuid
  selectedMembershipId String                      @db.Uuid
  assignedEmployeeId   String?                     @db.Uuid
  status               SupportTicketStatus         @default(OPEN)
  category             String                      @db.VarChar(80)
  description          String                      @db.VarChar(4000)
  createdAt            DateTime                    @default(now())
  closedAt             DateTime?
  updatedAt            DateTime                    @updatedAt
  notifications        SupportAccessNotification[]

  @@index([customerAccountId, status])
  @@index([homeId, status])
  @@index([assignedEmployeeId, status])
}

model SupportAccessRequest {
  id                            String                      @id @default(uuid()) @db.Uuid
  ticketId                      String                      @db.Uuid
  requestedByEmployeeId         String                      @db.Uuid
  homeId                        String                      @db.Uuid
  hubInstallationId             String                      @db.Uuid
  requestedScope                SupportAccessScope
  targetMembershipId            String?                     @db.Uuid
  targetUserId                  String?                     @db.Uuid
  canonicalAreaIds              Json
  targetIds                     Json
  touchesPropertyInfrastructure Boolean                     @default(false)
  status                        SupportAccessRequestStatus  @default(REQUESTED)
  approvedByMembershipId        String?                     @db.Uuid
  approvedAt                    DateTime?
  deniedAt                      DateTime?
  denialReason                  String?                     @db.VarChar(500)
  codeHash                      String?                     @db.VarChar(128)
  codeIssuedAt                  DateTime?
  codeExpiresAt                 DateTime?
  codeConsumedAt                DateTime?
  employeeHandoffHash           String?                     @db.VarChar(128)
  employeeHandoffEnvelope       String?                     @db.Text
  employeeHandoffIssuedAt       DateTime?
  employeeHandoffExpiresAt      DateTime?
  employeeHandoffConsumedAt     DateTime?
  codeAttemptCount              Int                         @default(0)
  sessionHardStopAt             DateTime?
  desiredRevokedAt              DateTime?
  hubRevokedAt                  DateTime?
  revision                      Int                         @default(1)
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  notifications                 SupportAccessNotification[]

  @@index([ticketId, status])
  @@index([homeId, status])
  @@index([requestedByEmployeeId, status])
  @@index([codeHash, codeExpiresAt])
}

model SupportSession {
  id                 String                      @id @default(uuid()) @db.Uuid
  accessRequestId    String                      @db.Uuid
  ticketId           String                      @db.Uuid
  employeeId         String                      @db.Uuid
  homeId             String                      @db.Uuid
  hubInstallationId  String                      @db.Uuid
  scope              SupportAccessScope
  areaIds            Json
  targetMembershipId String?                     @db.Uuid
  targetUserId       String?                     @db.Uuid
  status             SupportSessionStatus        @default(ACTIVE)
  leaseHash          String                      @unique @db.VarChar(128)
  approvedAt         DateTime
  expiresAt          DateTime
  desiredRevokedAt   DateTime?
  hubAcknowledgedAt  DateTime?
  endedAt            DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  notifications      SupportAccessNotification[]

  @@index([ticketId, status])
  @@index([hubInstallationId, status, expiresAt])
}

// Durable, privacy-scoped customer notification records for support access.
// Tenant-private sessions intentionally create no row. Property-level access
// creates one row per authorised homeowner/manager recipient and carries no
// tenant-private metadata.
model SupportAccessNotification {
  id                 String   @id @default(uuid()) @db.Uuid
  recipientAccountId String   @db.Uuid
  homeId             String   @db.Uuid
  ticketId           String   @db.Uuid
  accessRequestId    String   @db.Uuid
  sessionId          String?  @db.Uuid
  eventType          String   @db.VarChar(40)
  createdAt          DateTime @default(now())

  recipientAccount CustomerAccount      @relation(fields: [recipientAccountId], references: [id], onDelete: Cascade)
  home             Home                 @relation(fields: [homeId], references: [id], onDelete: Cascade)
  ticket           SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  accessRequest    SupportAccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  session          SupportSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([recipientAccountId, accessRequestId, eventType])
  @@index([recipientAccountId, createdAt])
  @@index([homeId, createdAt])
  @@index([ticketId, eventType])
}

model OfflineMembershipAuthorisation {
  id                  String    @id @default(uuid()) @db.Uuid
  trustedDeviceId     String    @db.Uuid
  membershipId        String    @db.Uuid
  homeId              String    @db.Uuid
  hubInstallationId   String    @db.Uuid
  publicKey           String    @db.Text
  publicKeyThumbprint String    @db.VarChar(128)
  areaIds             Json
  scopes              Json
  policyRevision      Int
  issuedAt            DateTime  @default(now())
  revokedAt           DateTime?
  revokeReason        String?   @db.VarChar(160)
  updatedAt           DateTime  @updatedAt

  @@unique([trustedDeviceId, membershipId, hubInstallationId])
  @@index([homeId, membershipId, revokedAt])
  @@index([publicKeyThumbprint, revokedAt])
}

model CloudUrlVerification {
  id                   String                     @id @default(uuid()) @db.Uuid
  hubInstallationId    String                     @db.Uuid
  homeId               String                     @db.Uuid
  reservedHostname     String                     @db.VarChar(255)
  tunnelId             String                     @db.VarChar(200)
  tunnelName           String                     @db.VarChar(200)
  cloudUrl             String                     @db.VarChar(500)
  challengeHash        String                     @db.VarChar(128)
  signedResponseDigest String?
  status               CloudUrlVerificationStatus @default(PENDING)
  issuedAt             DateTime                   @default(now())
  expiresAt            DateTime
  verifiedAt           DateTime?
  failedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([hubInstallationId, tunnelId])
  @@index([hubInstallationId, status])
}
