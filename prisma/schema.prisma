generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // Vercel's production functions run on Linux ARM64 while release builds may
  // be produced on macOS ARM64. Include both engines in prebuilt deployments.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime clients and guarded migration scripts inject the actual URL.
  // This non-secret local default keeps clean source snapshots reproducible.
  url      = "postgresql://127.0.0.1:5432/dinodia_v2_local"
}

