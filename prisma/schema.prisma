  hubInstallation HubInstallation    @relation(fields: [hubInstallationId], references: [id], onDelete: Restrict)
  trustedDevice   TrustedDevice?     @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)

  @@unique([claimReferenceId, nonceHash])
  @@index([hubInstallationId, expiresAt, consumedAt])
}

model HomeClaimReservation {
