model AlexaNativeLink {
  id                     String                @id @default(uuid()) @db.Uuid
  customerAccountId      String                @db.Uuid
  providerSubjectHash    String                @unique @db.VarChar(128)
  /// Alexa Event Gateway tokens are absent until the skill receives AcceptGrant.
  accessTokenCiphertext  String?               @db.Text
  refreshTokenCiphertext String?               @db.Text
  encryptionKeyVersion   Int
  status                 AlexaNativeLinkStatus @default(ACTIVE)
  /// True: every granted room of every active tenant membership is exposed; selections are kept in step automatically.
  autoScope              Boolean               @default(false)
  /// Endpoint ids Alexa was told about that were re-created under a new id; reported once as removed, then cleared.
  pendingDeleteEndpointIds Json?
  accessTokenExpiresAt   DateTime?
  revokedAt              DateTime?
