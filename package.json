{
  "name": "dinodia-platform-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:logs": "node scripts/check_no_unsafe_logs.mjs",
    "check:security": "node scripts/check_security_headers.mjs",
    "check:stage1": "node scripts/check_stage1_security.mjs",
    "test:stage1": "node scripts/test_stage1_contracts.mjs",
    "foundation:target": "node scripts/assert_v2_target.mjs --mode local",
    "prisma:deploy": "node scripts/assert_v2_target.mjs --mode \"${V2_ENVIRONMENT:-local}\" --run-prisma",
    "postinstall": "prisma generate",
    "check:email-uniqueness": "node scripts/checkEmailUniqueness.mjs",
    "secrets:backfill": "node scripts/backfillEncryptedSecrets.mjs",
    "verify:backfill": "node scripts/verifyBackfill.mjs",
    "label-registry:sync": "node scripts/labelRegistry.js sync",
    "label-registry:check": "node scripts/labelRegistry.js check"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.958.0",
    "@aws-sdk/client-sqs": "^3.958.0",
    "@prisma/client": "^6.19.0",
    "@vercel/functions": "^3.6.0",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.13",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.14",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
