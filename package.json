{
  "name": "dinodia-platform-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:dinodia-contracts": "node scripts/check_dinodia_contracts.mjs",
    "check:dinodia-contracts:swift": "bash ../dinodia-ios-app-V2/Scripts/check-dinodia-v1-runtime.sh",
    "check:dinodia-contracts:all": "npm run check:dinodia-contracts && npm run check:dinodia-contracts:swift",
    "check:aasa:runtime": "node scripts/check_aasa_runtime.mjs",
    "contracts:sync": "node scripts/sync_dinodia_contract_fixtures.mjs",
    "test": "node --test test/*.test.mjs",
    "test:target-guard": "node --test test/target_guard.test.mjs test/runtime_target.test.mjs",
    "check:logs": "node scripts/check_no_unsafe_logs.mjs",
    "check:security": "node scripts/check_security_headers.mjs",
    "check:foundation": "node scripts/check_foundation.mjs",
    "check:foundation:manifest": "node scripts/check_foundation_manifest.mjs",
    "check:stage1": "node scripts/check_stage1_security.mjs",
    "test:foundation": "node scripts/foundation_db_checks.mjs",
    "test:foundation:invariants": "node scripts/foundation_invariants.mjs",
    "test:stage1:db": "node scripts/stage1_db_checks.mjs",
    "test:stage1:integration": "node scripts/stage1_integration_harness.mjs",
    "test:stage1": "node --test test/stage1_security.test.mjs test/operator_rate_limit_policy.test.mjs && npm run test:stage1:integration",
    "check:native-schema": "node scripts/verify_native_schema.mjs",
    "test:stage3:domain": "node scripts/stage3_domain_checks.mjs",
    "stage3:migration:prepare": "node scripts/prepare_stage3_migration.mjs",
    "stage3:upgrade:check": "node scripts/verify_native_v2_upgrade_path.mjs",
    "stage3:migration:target": "node scripts/verify_native_v2_migration_target.mjs",
    "stage4:migration:target": "node scripts/verify_native_v2_migration_target.mjs --stage4-lan-tls",
    "stage5:migration:target": "node scripts/verify_native_v2_migration_target.mjs --stage5-sync",
    "stage5:incident-deadline:migration:target": "node scripts/verify_native_v2_migration_target.mjs --stage5-incident-deadlines",
    "stage5:incident-source-kind:migration:target": "node scripts/verify_native_v2_migration_target.mjs --stage5-incident-source-kind",
    "stage6:migration:target": "node scripts/verify_native_v2_migration_target.mjs --stage6-customer-auth",
    "stage8:migration:target": "node scripts/verify_native_v2_migration_target.mjs --stage8-commissioning",
    "evidence:production-read-only": "node scripts/read_only_production_inventory.mjs",
    "foundation:target": "node scripts/assert_v2_target.mjs --mode local",
    "db:validate-target": "node scripts/assert_v2_target.mjs --mode \"${V2_ENVIRONMENT:-local}\"",
    "db:local:up": "node scripts/local_database.mjs up",
    "db:local:down": "node scripts/local_database.mjs down",
    "db:local:reset": "node scripts/local_database.mjs reset",
    "db:migrate:local": "node scripts/assert_v2_target.mjs --mode local --run-prisma",
    "db:verify:fingerprint": "node scripts/schema_fingerprint.mjs",
    "db:reset:rc": "node scripts/reset_rc_database.mjs",
    "db:migrate:rc": "node scripts/assert_v2_target.mjs --mode rc --run-prisma",
    "postinstall": "prisma generate",
    "clean-clone:check": "node scripts/check_clean_clone.mjs",
    "manufacturing:enroll": "node scripts/enrol_manufactured_hub.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1140.0",
    "@prisma/client": "^6.19.0",
    "next": "16.3.8",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.14",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "js-yaml": "^4.3.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
