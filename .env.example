# Server-only placeholders. Generate/store real values outside Git.
SUPABASE_ANON_KEY=replace-with-v2-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-v2-service-role-key
JWT_SECRET=replace-with-long-random-jwt-secret
