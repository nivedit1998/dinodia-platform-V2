CRON_SECRET=replace-with-long-random-cron-secret
VERCEL_AUTOMATION_BYPASS_SECRET=replace-with-preview-only-secret

# Stage 1 asymmetric trust material. Store private keys only in approved
# encrypted/server-side stores; public verifier keys may also be installed
# in protected Dinodia OS configuration. Never commit real key material.
COMPANY_PORTAL_SESSION_PRIVATE_KEY=replace-with-company-session-ed25519-private-key
COMPANY_PORTAL_SESSION_PUBLIC_KEYS=replace-with-company-session-ed25519-public-key
DINODIA_APP_SESSION_PRIVATE_KEY=replace-with-app-session-ed25519-private-key
DINODIA_APP_PUBLIC_KEYS=replace-with-app-session-ed25519-public-key
OPERATOR_SESSION_PRIVATE_KEY=replace-with-operator-session-ed25519-private-key
DINODIA_OPERATOR_PUBLIC_KEY=replace-with-operator-session-ed25519-public-key
MANUFACTURING_ROOT_PUBLIC_KEYS=replace-with-dinodia-manufacturing-root-public-key
# Production manufacturing enrollment additionally requires a detached
# signature from this separate authorised manufacturing operator key set.
MANUFACTURING_ENROLLMENT_OPERATOR_PUBLIC_KEYS=replace-with-authorised-manufacturing-operator-public-key
STAGE1_CONTRACT_SECRET=replace-with-local-contract-harness-secret
COMPANY_PORTAL_INITIAL_CXO_BOOTSTRAP_SECRET=replace-with-one-use-empty-database-bootstrap-secret
COMPANY_PORTAL_INITIAL_CXO_EMAIL=replace-with-verified-initial-cxo-mailbox
AWS_REGION=replace-with-ses-region
SES_FROM_EMAIL=no-reply@dinodiasmartliving.com
# Use the Vercel/AWS default credential chain; never expose these to the client.
AWS_ACCESS_KEY_ID=replace-with-narrow-ses-sender-access-key
AWS_SECRET_ACCESS_KEY=replace-with-narrow-ses-sender-secret

# Deployment-provided metadata only; never add secrets to this file.
